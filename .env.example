# Copie para .env (gitignored) e preencha os valores reais. O docker-compose
# lê o .env da raiz automaticamente.

# Senha do certificado usado em ./certificado/certificado.pfx (serviço toggl_report_api).
KESTREL_CERT_PASSWORD=

# Autenticação HTTP Basic da Api — opcional. Deixe as duas em branco pra
# manter a Api sem autenticação (padrão, uso local). Preenchendo as duas,
# a Api passa a exigir login (tela própria no frontend, ver CLAUDE.md §4.8).
AUTH__USUARIO=
AUTH__SENHA=

# Chave usada para criptografar os tokens do Toggl salvos nos .ini —
# opcional. Sem ela, os tokens ainda são criptografados, só que com uma
# chave padrão embutida no código-fonte (proteção mínima).
CHAVE_CRIPTOGRAFIA=